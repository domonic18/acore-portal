# 生产反代(Caddy 2):自动签发/续期 Let's Encrypt 证书,SITE_DOMAIN 与 ACME_EMAIL 由 compose 注入
# 注意:证书与 ACME 账号落在 workspace/caddy-data,caddy 容器重建不丢(丢了会触发签发频率限制)
{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# 反代到 web 容器;Range 头默认透传(视频拖动进度条依赖)
	reverse_proxy web:3000

	# 上传体积不在此设限:媒体库的体积闸门在应用层(图/PDF 10MB、视频 50MB),
	# 网关再限会先于应用层拒绝,错误提示也拿不到中文文案
	# 但认证类接口的正文极小(用户名/密码/令牌),单独收一道闸门(2026-11-06 撞库加固)
	@authpath path /api/auth/* /api/account/*
	request_body @authpath {
		max_size 32KB
	}

	# 安全响应头(2026-11-06 撞库加固;X-Frame-Options 于 2026-11-07 与应用层对齐)
	# 应用层(next.config.mjs)已设同一套头 + CSP + Permissions-Policy;
	# 此处保留边缘副本,覆盖「边缘在、应用层被改坏」的场景;同名头以本块为准
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}

	# HSTS 注释说明:全站 HTTPS 稳定后再开 includeSubDomains
	# (带 includeSubDomains 时子域名未全量 https 会锁死)
}

# www → 主域 301(2026-11-14 补:老站这跳是 WordPress 的 canonical 提供的,
# nginx 里没有,新栈是 Next.js 不自带 → 不复刻会让 www 与主域重复内容)
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# api.lokta.cn → 排行榜 wrapper(wow_web 容器)。
# 老站由 nginx 的 wow_wrapper_proxy.conf 反代(proxy_pass http://wow_web:80 + Host $host),
# 老栈下线后这层代理消失 → 在此复刻,口径与老站一致(Host 透传为 api.lokta.cn)。
# wow_web 与老栈同在 local-shared-net;prod compose 已把 caddy 接入该网(external)。
api.lokta.cn {
	reverse_proxy wow_web:80 {
		header_up Host api.lokta.cn
	}
}


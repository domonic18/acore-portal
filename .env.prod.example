# acore-portal 生产环境变量样例
# 复制为 .env.prod 后填真实值;.env.prod 已 gitignore 永不入库
# 仅基础设施引导凭据(宪法 v1.0.2);业务通道配置(SMTP/SOAP/COS/站点地址/统计)
# 存业务库 system_config 表,部署后进后台「设置」改,不在本文件

# 运行环境
NODE_ENV=production
# openssl rand -hex 32 生成;会话签发与校验的根密钥,泄露=可伪造登录态
SESSION_SECRET=change-me-generate-with-openssl-rand-hex-32

# 新业务库(compose 网络内走服务名 mysql:3306)
DATABASE_URL=mysql://acore_portal:change-me@mysql:3306/acore_portal

# Redis
REDIS_URL=redis://redis:6379/0

# MySQL 容器账号(须与 DATABASE_URL 一致)
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# 反代域名与证书签发通知邮箱(caddy 自动签 Let's Encrypt)
SITE_DOMAIN=lokta.cn
ACME_EMAIL=admin@lokta.cn

# 游戏通道 TCP 代理的上游(玩家直连本机 3724/8086,由 nginx stream 转发到这里)
# 形如 host:port;**真实地址只落宿主 .env.prod,不入库、不入文档**(本仓是 public)
GAME_AUTH_UPSTREAM=change-me-host:3724
GAME_WORLD_UPSTREAM=change-me-host:8086

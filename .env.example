# acore-portal 环境变量样例(仅基础设施引导凭据,宪法 v1.0.2)
# 复制为 .env 后填写真实值;.env 永不入库
# 游戏库连接串与业务通道配置(SMTP/SOAP/站点地址)存业务库 system_config 表,
# 见 scripts/dev/initdb/init-system-config.sql,管理变更经 lib/config.ts reload
# 本地 dev 默认值与 docker/docker-compose.dev.yml 的 fixture 账号一致,可直接使用

# 运行环境
NODE_ENV=development
# 会话签名密钥(Edge middleware 运行时查不了 MySQL,故留 env;生产用 openssl rand -hex 32)
SESSION_SECRET=dev-only-session-secret-change-me

# 新业务库(MySQL;system_config 所在库,引导级凭据)
DATABASE_URL=mysql://acore_portal:acore_portal@localhost:3307/acore_portal

# Redis(session/限速/热点缓存)
REDIS_URL=redis://localhost:6381/0

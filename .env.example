# acore-portal 环境变量样例
# 复制为 .env 后填写真实值;.env 永不入库
# 游戏库/SOAP 凭据从生产获取时走安全渠道,不入库不入文档
# 本地 dev 默认值与 docker/docker-compose.dev.yml 的 fixture 账号一致,可直接使用

# 运行环境
NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=dev-only-session-secret-change-me

# 新业务库(MySQL)
DATABASE_URL=mysql://acore_portal:acore_portal@localhost:3307/acore_portal

# 游戏四库(本地 fixture:auth 库用具备 account 写权限的账号,其余只读)
GAME_DB_AUTH_URL=mysql://acore_auth_writer:auth_writer_pass@localhost:3307/acore_auth
GAME_DB_CHARACTERS_URL=mysql://acore_reader:reader_pass@localhost:3307/acore_characters
GAME_DB_WORLD_URL=mysql://acore_reader:reader_pass@localhost:3307/acore_world
GAME_DB_ELUNA_URL=mysql://acore_reader:reader_pass@localhost:3307/eluna

# Redis(session/限速/热点缓存)
REDIS_URL=redis://localhost:6381/0

# SOAP -> acore worldserver(dev 默认指向本地 SOAP mock)
SOAP_URL=http://localhost:7878/
SOAP_USER=soaper
SOAP_PASSWORD=change-me
SOAP_REALM=Dev

# SMTP 邮件(dev 默认 Mailpit,捕获不发真信,UI http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=dev@lokta.local

# Cloudflare Turnstile(M4 公网暴露前启用)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 腾讯云 COS + CDN(M2+)
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=

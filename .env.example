# acore-portal 环境变量样例
# 复制为 .env 后填写真实值;.env 永不入库
# 游戏库/SOAP 凭据从生产获取时走安全渠道,不入库不入文档

# 运行环境
NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=change-me

# 新业务库(MySQL)
DATABASE_URL=mysql://acore_portal:acore_portal@localhost:3306/acore_portal

# 游戏四库(凭据与生产 docker 网络有关,按实际环境填写)
GAME_DB_AUTH_URL=mysql://user:pass@localhost:3306/acore_auth
GAME_DB_CHARACTERS_URL=mysql://user:pass@localhost:3306/acore_characters
GAME_DB_WORLD_URL=mysql://user:pass@localhost:3306/acore_world
GAME_DB_ELUNA_URL=mysql://user:pass@localhost:3306/eluna

# Redis(session/验证码限速/热点缓存)
REDIS_URL=redis://localhost:6379/0

# SOAP -> acore worldserver(发货/角色服务命令通道)
SOAP_URL=http://localhost:7878/
SOAP_USER=soaper
SOAP_PASSWORD=change-me
SOAP_REALM=Dev

# SMTP 邮件(沿用现有发件账号)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Cloudflare Turnstile(登录/注册人机验证)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 腾讯云 COS + CDN(存量 4.4G 图片迁入)
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=

# acore-portal 测试环境变量样例(Mac Mini 常驻栈,公网 dev.17aitech.com)
# 复制为 .env.test 后按需调整;.env.test 已 gitignore 永不入库
# 仅基础设施引导凭据(宪法 v1.0.2);游戏库连接串与业务通道配置(SMTP/SOAP/站点地址)
# 存业务库 system_config 表,容器内取值见 scripts/dev/initdb/init-system-config.sql
# 容器内互访走 compose 服务名;宿主端口:mysql 3308 / redis 6382 / web 9000

# 运行环境
NODE_ENV=production
SESSION_SECRET=change-me-generate-with-openssl-rand-hex-32

# 新业务库(compose 网络内)
DATABASE_URL=mysql://acore_portal:acore_portal@mysql:3306/acore_portal

# Redis
REDIS_URL=redis://redis:6379/0

// 游戏库 acore_auth:仅 introspect,零 DDL(宪法 V)
// 防写根本防线 = MySQL 账号权限(acore_auth_writer 仅 account 表 INSERT/UPDATE);应用层在 lib/db 收口
// M1 触碰面:account(契约写:注册 INSERT / 改密 UPDATE,research R3/R5)
generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/auth"
}

datasource db {
  provider = "mysql"
  url      = env("GAME_DB_AUTH_URL")
}

model Account {
  id       Int      @id @default(autoincrement()) @db.UnsignedInt
  username String   @unique @db.VarChar(32) // UPPER 存储
  salt     Bytes    @db.Binary(32) // SRP6 随机盐
  verifier Bytes    @db.Binary(32) // SRP6 verifier(小端落库,口径见 game-hash.ts)
  email    String   @default("") @db.VarChar(255)
  regMail  String   @map("reg_mail") @default("") @db.VarChar(255)
  joindate DateTime @default(now()) @db.Timestamp

  @@map("account")
}

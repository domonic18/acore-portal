// 游戏库 acore_world:只读,M1 连接自检(FR-022);M2 增 item_template 子集(sku-check 存在性校验 FR-126)
generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/world"
}

datasource db {
  provider = "mysql"
  url      = env("GAME_DB_WORLD_URL")
}

// 连接探针:被 @@ignore 排除,不生成查询类型,仅为 schema 合法性占位
model ConnectionProbe {
  id Int @id

  @@map("_connection_probe")
  @@ignore
}

/// 物品模板(只读子集;真实表列远多于此,Prisma 仅映射触碰列)
model ItemTemplate {
  entry   Int     @id @map("entry")
  name    String? @db.VarChar(255)
  quality Int?
  /// 最大堆叠数(AC 真表 stackable int default 1):1=不可堆叠,>1=可堆叠。
  /// 堆叠物品走 itemsend_{id}_stack(一封邮件发 qty 个),非堆叠走 qty 封各 1 个。
  stackable Int? @map("stackable")

  @@map("item_template")
}

/// 物品本地化名称(只读;AC 真表主键 (ID, locale))
/// 后台物品选择器显示中文名用(issue #151):item_template.name 是英文名,
/// 中文名在 item_template_locale 的 zhCN 行。表可能不存在(精简游戏库),
/// 服务层据此降级为「只显示英文名」,不阻断检索。
model ItemTemplateLocale {
  id     Int    @map("ID")
  locale String @db.VarChar(4)
  name   String? @map("Name") @db.Text

  @@id([id, locale])
  @@map("item_template_locale")
}

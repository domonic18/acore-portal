# 环境变量与密钥(白名单:只提交 *.example 模板,其余 .env* 一律忽略防误入库)
.env
.env.*
!.env.example
!.env.test.example
!.env.prod.example

# 宿主机持久化数据(workspace 内容不入库,保留目录)
workspace/*
!workspace/.gitkeep

# 预发布自动部署写入的当前部署提交号(部署根 = 本仓根时落在此处)
current-sha

# 里程碑特性规格(specs/):SDD 过程产物,仅本地工作区,不入库
# 交付形态与验收锚点以 docs/plan/development-plan.md(状态)为准
specs/

# 依赖
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# 构建产物
dist/
build/
# scripts/build/ 是入库的构建辅助脚本目录(vditor 资产拷贝等),不吃上面的 build/ 通配
!scripts/build/
# vditor 运行时静态资产(dev/build 脚本链从 node_modules 拷贝的产物,不入库)
public/vditor/
.next/
*.log

# Prisma 多 client 生成物(不入库,clone 后 pnpm db:generate)
src/generated/

# Playwright
playwright-report/
test-results/
.playwright-mcp/

# 测试覆盖率
coverage/

# IDE / 系统
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json

# TS 增量构建缓存
*.tsbuildinfo

# cc-connect 消息桥本地状态(会话附件缓存)
.cc-connect/

# 根目录 UI 验证截图(反馈会话产物,历史截图已移 workspace/screenshots)
/*.png

# .claude/skills 本地 hub 符号链接不入库(绝对路径链接跨机器死链;
# speckit-* 为已入库真实文件,保持可提交)
.claude/skills/*
!.claude/skills/speckit-*
